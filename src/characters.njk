---
layout: base.njk
pageTitle: Karakterler
pageClass: characters
permalink: /characters/
---
{%- from "partials/cards.njk" import polaroid, seedling -%}
{%- set garden = collections.characters | garden(upcomingCharacters) %}

<section class="intro">
    <p class="eyebrow">bahçede dolaşan</p>
    <h2 class="page-title">Karakterler</h2>
</section>

<section class="garden-bed" aria-labelledby="planted-title">
    <header class="bed-head">
        <h2 id="planted-title">Blooming Flowers</h2>
        <p>Birine tıkla, yolculuğa başla!</p>
    </header>
    <div class="polaroid-wall">
        {%- for c in garden.planted %}
        {{ polaroid(c) }}
        {%- endfor %}
    </div>
</section>

{%- if garden.sprouting.length %}
<section class="garden-bed garden-bed--seeds" aria-labelledby="seeds-title">
    <header class="bed-head">
        <h2 id="seeds-title">Still a little sapling, just a sprout</h2>
    </header>
    <div class="seed-tray">
        {%- for c in garden.sprouting %}
        {{ seedling(c) }}
        {%- endfor %}
    </div>
</section>
{%- endif %}
