{#- One layout for every character page: the profile, the stories home and each story. -#}
{%- set profile = collections.characters | profileFor(characterId) -%}
{%- set c = profile.data -%}
{%- set groups = collections.stories | storyGroups(characterId, c.categories) -%}
<!DOCTYPE html>
<html lang="{{ site.language }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if pageKind != "profile" %}{{ title }} • {% endif %}{{ c.name }} | {{ site.title }}</title>
        {%- if c.portrait %}
        <link rel="icon" href="{{ profile.url }}{{ c.portrait }}">
        {%- endif %}
        {%- if c.fonts %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="{{ c.fonts }}">
        {%- endif %}
        <link rel="stylesheet" href="/assets/css/character.css">
        <style>
            :root {
                {%- for key, value in c.theme %}
                --{{ key }}: {{ value | safe }};
                {%- endfor %}
            }
        </style>
        {%- if c.hasThemeCss %}
        <link rel="stylesheet" href="{{ profile.url }}theme.css">
        {%- endif %}
    </head>
    <body class="character-page character-{{ characterId }} page-{{ pageKind }}{% if storyCategory %} category-{{ storyCategory }}{% endif %}">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="topbar-back" href="/characters/">← Bahçe</a>
                <a class="topbar-name" href="{{ profile.url }}"><span aria-hidden="true">{{ c.icon or "✦" }}</span> {{ c.name }}</a>
                <nav class="topbar-links" aria-label="Karakter gezinme">
                    <a href="{{ profile.url }}"{% if pageKind == "profile" %} aria-current="page"{% endif %}>Karakter</a>
                    {%- if groups.length %}
                    <a href="{{ profile.url }}hikayeler/"{% if pageKind != "profile" %} aria-current="page"{% endif %}>Hikâyeler</a>
                    {%- endif %}
                </nav>
            </div>
            {%- if pageKind == "story" %}
            <span class="reading-progress" aria-hidden="true"></span>
            {%- endif %}
        </header>

        <div class="wrapper">
            <main>
                {%- if pageKind == "profile" %}
                {%- include "partials/profile.njk" %}
                {%- else %}
                {%- include "partials/reader.njk" %}
                {%- endif %}
            </main>

            <footer class="character-footer">
                <span>{{ c.footer or "✦" }}</span>
                <a href="/characters/">Hayal Bahçesi'ne dön</a>
            </footer>
        </div>

        <dialog class="lightbox" aria-label="Büyütülmüş resim"><img alt=""></dialog>
        <script src="/assets/js/lightbox.js" defer></script>
    </body>
</html>
