<!DOCTYPE html>
<html lang="{{ site.language }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if pageTitle %}{{ pageTitle }} • {% endif %}{{ site.title }}</title>
        <link rel="icon" href="/assets/images/logo1.png">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/assets/css/site.css">
    </head>
    <body class="page-{{ pageClass or 'home' }}">
        <div class="wrapper">
            <header class="site-header">
                <a class="brand" href="/" aria-label="{{ site.title }}: ana sayfa">
                    <img src="/assets/images/logo1.png" class="logo" alt="" loading="eager">
                </a>
                <p class="decoration" aria-hidden="true">⊹ ࣪ ˖ 🌸 ˖ ࣪ ⊹</p>
                <h1>{{ site.title }}</h1>
                <p class="subtitle">{{ site.subtitle }}</p>
                <nav class="site-nav" aria-label="Ana gezinme">
                    {%- for item in site.nav %}
                    <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    {%- endfor %}
                </nav>
            </header>

            <main>
                {{ content | safe }}
            </main>

            <footer class="site-footer">
                <span class="footer-vine" aria-hidden="true">˚ ♡ ⋆｡˚ ❀ ˚｡⋆ ♡ ˚</span>
                <span>{{ site.footer }}</span>
            </footer>
        </div>
    </body>
</html>
