---
layout: base.njk
---
<section class="content-box post-composer" aria-labelledby="post-form-title">
    <h2 id="post-form-title">Post an Update</h2>
    <form class="post-form" id="post-form">
        <textarea id="post-content" name="content" required placeholder="Write something..."></textarea>
        <button type="submit">Publish Post</button>
        <p class="post-status" id="post-status" role="status" aria-live="polite"></p>
    </form>
</section>

<section class="content-box" aria-labelledby="posts-title">
    <h2 id="posts-title">Posts</h2>
    <div class="post-list" id="post-list" aria-live="polite"></div>
</section>

<script>window.HayalBahcesiConfig = {{ site.posts | dump | safe }};</script>
<script src="/assets/js/posts.js" defer></script>
